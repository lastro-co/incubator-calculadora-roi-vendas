{
  "name": "calculadora-roi-vendas",
  "description": "Calculadora de ROI para o time de vendas mostrar o retorno financeiro que clientes terão usando a plataforma Lastro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "predev": "pnpm update @lastro-co/design-system",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "TZ=UTC jest",
    "test:watch": "TZ=UTC jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.34.0",
    "@datadog/browser-rum": "^6.26.0",
