# =============================================================================
# Next UI Starter - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values
# Never commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Environment Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# BFF (Backend For Frontend) URL
NEXT_PUBLIC_BFF_URL=http://localhost:3000

# Agency ID for multi-tenancy (optional)
NEXT_PUBLIC_AGENCY_ID=

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Lastro App
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# NextAuth Configuration
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# -----------------------------------------------------------------------------
# Keycloak Configuration (Server-side - NextAuth)
# -----------------------------------------------------------------------------
KEYCLOAK_ID=your-keycloak-client-id
KEYCLOAK_SECRET=your-keycloak-client-secret
KEYCLOAK_ISSUER=http://localhost:8080/realms/your-realm

# -----------------------------------------------------------------------------
# Keycloak Configuration (Client-side)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=your-realm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=your-keycloak-client-id

# -----------------------------------------------------------------------------
# Socket.IO Configuration (optional)
# -----------------------------------------------------------------------------
# General socket URL
NEXT_PUBLIC_SOCKET_URL=ws://localhost:3001
# WebSocket URL for real-time chat functionality
# Must use wss:// protocol for secure connections in production
NEXT_PUBLIC_CHAT_SOCKET_URL=

# -----------------------------------------------------------------------------
# Datadog RUM Configuration (optional)
# -----------------------------------------------------------------------------
# Real User Monitoring for performance and error tracking
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=
NEXT_PUBLIC_DATADOG_APPLICATION_ID=
NEXT_PUBLIC_DATADOG_ENV=development
NEXT_PUBLIC_DATADOG_VERSION=1.0.0
NEXT_PUBLIC_DATADOG_SITE=datadoghq.com
NEXT_PUBLIC_DATADOG_SERVICE=

# -----------------------------------------------------------------------------
# Amplitude Analytics (Server-side only, optional)
# -----------------------------------------------------------------------------
AMPLITUDE_API_KEY=

# -----------------------------------------------------------------------------
# Analytics PII Control (Server-side only)
# -----------------------------------------------------------------------------
# Controls collection of Personally Identifiable Information
# - false (default): Only collect non-PII data (country, device info)
# - true: Collect PII with anonymization (hashed IP, coarse ~10km coordinates)
# Important: Enabling this may require user consent under GDPR/LGPD
ANALYTICS_CAPTURE_PII=false

# =============================================================================
# Mock Service Worker (MSW) - API Mocking
# =============================================================================
# Enable API request mocking for development
# Useful when backend API is not available or under development
#
# Options:
# - false (default): All requests go to real API (NEXT_PUBLIC_BFF_URL)
# - true: Requests are intercepted and return mock data
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_MOCKS=false

# How to use MSW:
# ----------------
# 1. Set NEXT_PUBLIC_ENABLE_MOCKS=true
# 2. Restart your development server (pnpm dev)
# 3. All API requests will be intercepted and return mock data
# 4. Check browser console for MSW logs: "[MSW] Mocking enabled"
# 5. Mock data is defined in src/mocks/data/
# 6. Mock handlers are defined in src/mocks/handlers/
#
# Advanced Configuration:
# -----------------------
# Fine-tune which endpoints to mock in src/mocks/config.ts
# You can mix mock and real API calls:
#
# Example 1 - Mock everything:
#   NEXT_PUBLIC_ENABLE_MOCKS=true
#   Keep all endpoints as 'enabled: true' in config.ts
#
# Example 2 - Hybrid (some mock, some real):
#   NEXT_PUBLIC_ENABLE_MOCKS=true
#   Edit src/mocks/config.ts:
#     chat: { enabled: false }  // Uses real API
#     lead: { enabled: true }   // Uses mocks
#
# Example 3 - Granular control:
#   NEXT_PUBLIC_ENABLE_MOCKS=true
#   Edit src/mocks/config.ts:
#     chat: {
#       getChats: true,    // Mock - faster UI testing
#       sendMessage: false // Real - test integration
#     }
#
# Documentation:
# --------------
# Full documentation: src/mocks/README.md
# Usage examples: src/mocks/EXAMPLES.md
# Configuration: src/mocks/config.ts
